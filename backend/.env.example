# Скопируйте в backend/.env и заполните реальными значениями.
# backend/.env в git не попадает. Реальные переменные окружения имеют
# приоритет над значениями из файла.

# Каталог с исходными изображениями статей (frontend/public/img): при старте
# они импортируются в медиахранилище с генерацией webp-вариантов. Менять
# нужно, только если бэкенд запускают не из backend/ или каталог переехал.
ABBERANT_SEED_IMAGES_DIR=../frontend/public/img

# SMTP (для писем с кодами регистрации и 2FA). Пока SMTP_HOST пуст,
# коды печатаются в лог сервера и возвращаются клиенту как devCode.
# Gmail: нужен App Password (аккаунт с 2FA → Security → App passwords).
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (SMTP_STARTTLS=true), 465 = implicit TLS (SMTP_STARTTLS=false)
SMTP_PORT=465
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_FROM=your.address@gmail.com
SMTP_STARTTLS=false
